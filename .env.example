# ============================================================
# InnieAI Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- SUPABASE ---
# Found in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Also set these for browser-side Supabase client:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- ANTHROPIC ---
# Found in: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# --- RESEND ---
# Found in: resend.com → API Keys
# Add your domain in Resend and verify DNS before sending
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@yourdomain.com
RESEND_DOMAIN=yourdomain.com

# --- STRIPE ---
# Found in: dashboard.stripe.com → Developers → API Keys
# Use test keys (sk_test_...) for development
STRIPE_SECRET_KEY=sk_test_...

# Found in: dashboard.stripe.com → Developers → Webhooks
# Run: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Create these products/prices in Stripe Dashboard:
# Starter: $1,500/mo subscription + $1,500 one-time setup
# Growth: $2,500/mo subscription + $2,000 one-time setup
# Scale: $4,000/mo subscription + $2,500 one-time setup
STRIPE_STARTER_MONTHLY_PRICE_ID=price_...
STRIPE_GROWTH_MONTHLY_PRICE_ID=price_...
STRIPE_SCALE_MONTHLY_PRICE_ID=price_...
STRIPE_STARTER_SETUP_PRICE_ID=price_...
STRIPE_GROWTH_SETUP_PRICE_ID=price_...
STRIPE_SCALE_SETUP_PRICE_ID=price_...

# --- GOOGLE PLACES ---
# Found in: console.cloud.google.com → APIs → Places API → Credentials
# Enable: Places API (New)
GOOGLE_PLACES_API_KEY=AIza...

# --- APP SETTINGS ---
OWNER_EMAIL=your@email.com
NEXT_PUBLIC_BASE_URL=https://innieai.co
CALCOM_LINK=https://cal.com/yourusername
